# =========================================================================
# RiceCare AI — Production Environment Configuration (.env.production)
# =========================================================================

# Application Server Port (Render / Railway / Cloud Run sets this dynamically)
PORT=8000

# Secret Key for JWT Token Signature (generate a 64-character random string)
SECRET_KEY=ricecare_ai_super_secret_production_key_2026_change_in_production

# Admin API Key for publishing remote configurations, backups, and model updates
ADMIN_API_KEY=ricecare_admin_secure_key_2026

# Allowed CORS Origins (comma-separated or * for public mobile access)
ALLOWED_ORIGINS=*

# Public HTTPS URL of the deployed application (used for asset resolution)
PUBLIC_APP_URL=https://ricecare-ai.onrender.com

# Environment mode
ENVIRONMENT=production
