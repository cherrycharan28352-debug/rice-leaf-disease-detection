# RiceCare AI - Environment Configuration Example

# Server Settings
PORT=8000
HOST=0.0.0.0
DEBUG=False

# Security Keys
SECRET_KEY=your_secure_random_production_secret_key_change_me_in_production

# Database
# Default SQLite local database
DATABASE_PATH=agriversion.db

# Storage Directories
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Machine Learning Thresholds
CONFIDENCE_THRESHOLD=60.0
BLUR_THRESHOLD=60.0
